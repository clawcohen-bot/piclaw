{
  "name": "telegram-pi-agent",
  "projectType": "application",
  "sourceRoot": "apps/telegram-pi-agent/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --env-file=.env apps/telegram-pi-agent/src/main.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/telegram-pi-agent/tsconfig.json --noEmit"
      }
    }
  }
}
